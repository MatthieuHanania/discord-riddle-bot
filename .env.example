# Discord Bot Configuration
# Copy this file to .env and fill in your secret Discord Bot Token:
# Windows (PowerShell): copy .env.example .env

# [Obligatoire] Le token secret de votre bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=YOUR_DISCORD_TOKEN_HERE

# [Optionnel] ID de serveur pour synchroniser instantanément les Slash Commands en développement
# Sans cet ID, Discord met en cache les commandes globales (peut prendre jusqu'à 1 heure).
# DEV_GUILD_ID=123456789012345678
