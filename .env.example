# Discord Bot Configuration Example
# Copy this file to .env and fill in your Discord Bot Token:
# Windows (PowerShell/CMD): copy .env.example .env
# Linux / macOS:            cp .env.example .env

DISCORD_TOKEN=YOUR_DISCORD_TOKEN_HERE
RIDDLE_TEXT=Le détective anglais est a moitié enfermé
RIDDLE_ANSWER=lock

# Optional: Saved target user IDs (comma-separated, automatically persisted when using @RiddleBot spy)
# TARGET_USER_IDS=123456789012345678,987654321098765432

